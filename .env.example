# Copie para .env.development para desenvolvimento local.
# Em produção, configure estas variáveis no painel do serviço de hospedagem.
SHOPWISE_DEBUG=true
SHOPWISE_SECRET_KEY=apenas-para-desenvolvimento-local
SHOPWISE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SHOPWISE_CORS_ORIGINS=http://localhost:8100,http://127.0.0.1:8100,http://localhost:4200,http://127.0.0.1:4200

# Sem DATABASE_URL, o projeto usa o SQLite local (db.sqlite3).
# Na hospedagem, informe a URL PostgreSQL fornecida pelo serviço.
# DATABASE_URL=postgresql://usuario:senha@host:5432/shopwise
